# Flash y particiones (partitions.csv: NVS + OTA x2 + SPIFFS). Sin esto, ESP-IDF
# usaría flash de 2 MB y tabla "single app" -> sin OTA ni SPIFFS.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_COMPILER_ORPHAN_SECTIONS_WARNING=y

# HTTP server / WebSocket
CONFIG_HTTPD_WS_SUPPORT=y
# Callback tras el handshake /ws: alimenta el contador "hs" de /api/rx/stats.
CONFIG_HTTPD_WS_POST_HANDSHAKE_CB_SUPPORT=y

# WiFi (ahorro de RAM)
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_ENABLE_WPA3_SAE=n
CONFIG_ESP_WIFI_ENABLE_WPA3_OWE_STA=n

# lwIP
CONFIG_LWIP_IP_FORWARD=y
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_LWIP_IPV6=n
CONFIG_LWIP_TCP_RTO_TIME=8000

# OTA: rollback automático si la imagen nueva no se confirma (main.c: ota_validate_task)
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
